# ── LLM provider selection ────────────────────────────────────────────────
# LLM_PROVIDER=glm    → uses GLM-4.6 via z.ai (default)
# LLM_PROVIDER=claude → uses Claude Sonnet 4.6 via Anthropic SDK (fallback)

LLM_PROVIDER=glm

# GLM (z.ai) — required when LLM_PROVIDER=glm
GLM_API_KEY=<your-glm-key>

# Claude (Anthropic) — required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# ── x402 payments ─────────────────────────────────────────────────────────
# Disposable Base mainnet wallet for Apify actor calls via x402 protocol.
# SECURITY: NEVER commit the real private key — keep it local-only in .env
# The address (0xaE7c...7f62) is safe to share; fund it with USDC on Base.
# Generate a fresh wallet: cd packages/backend && npx tsx scripts/generate-wallet.ts
WALLET_PRIVATE_KEY=0x...

# Set to false to bypass x402 and use APIFY_TOKEN below (demo-day escape hatch).
# When true (default), any x402 failure throws loudly — NO silent fallback.
X402_ENABLED=true

# Optional: override the Base mainnet RPC (defaults to https://mainnet.base.org)
# BASE_RPC_URL=https://mainnet.base.org

# Apify token — used only when X402_ENABLED=false
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# ShieldPass backend
PORT=8787
DB_PATH=./shieldpass.db
LOG_LEVEL=info
CORS_ORIGIN=*
