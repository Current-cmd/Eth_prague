# ── LLM provider selection ────────────────────────────────────────────────
# LLM_PROVIDER=glm    → uses GLM-4.6 via z.ai (default)
# LLM_PROVIDER=claude → uses Claude Sonnet 4.6 via Anthropic SDK (fallback)

LLM_PROVIDER=glm

# GLM (z.ai) — required when LLM_PROVIDER=glm
GLM_API_KEY=<your-glm-key>

# Claude (Anthropic) — required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# ShieldPass backend
PORT=8787
DB_PATH=./shieldpass.db
LOG_LEVEL=info
CORS_ORIGIN=*
