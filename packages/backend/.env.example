# ShieldPass backend — environment variables
# Copy this file to .env and fill in real values.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── Space KMS (Orbitport) ────────────────────────────────────────────────────
# Required for POST /v1/badges/register (badge credential KMS storage).
# Obtain credentials from https://docs.spacecomputer.io
ORBITPORT_CLIENT_ID=your-orbitport-client-id-here
ORBITPORT_CLIENT_SECRET=your-orbitport-client-secret-here

# ── Pinata (IPFS) ────────────────────────────────────────────────────────────
PINATA_JWT=your-pinata-jwt-here

# ── LLM provider selection ────────────────────────────────────────────────
# LLM_PROVIDER=glm    → uses GLM-4.6 via z.ai (default)
# LLM_PROVIDER=claude → uses Claude Sonnet 4.6 via Anthropic SDK (fallback)
LLM_PROVIDER=glm

# GLM (z.ai) — required when LLM_PROVIDER=glm
GLM_API_KEY=<your-glm-key>

# Claude (Anthropic) — required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# ── x402 payments ─────────────────────────────────────────────────────────
# Disposable Base mainnet wallet for Apify actor calls via x402 protocol.
# SECURITY: NEVER commit the real private key — keep it local-only in .env
# The address (0xaE7c...7f62) is safe to share; fund it with USDC on Base.
# Generate a fresh wallet: cd packages/backend && npx tsx scripts/generate-wallet.ts
WALLET_PRIVATE_KEY=0x...

# Set to false to bypass x402 and use APIFY_TOKEN below (demo-day escape hatch).
# When true (default), any x402 failure throws loudly — NO silent fallback.
X402_ENABLED=true

# Optional: override the Base mainnet RPC (defaults to https://mainnet.base.org)
# BASE_RPC_URL=https://mainnet.base.org

# Apify token — used only when X402_ENABLED=false
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# ── Blockchain / Contracts ────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
COMPANY_REGISTRY=0x...
BADGE_TREE_MANAGER=0x...
REPORT_REGISTRY=0x...
SHIELDPASS_RESOLVER=0x...
RISC0_VERIFIER=0x...
BOUNDLESS_MARKET=0x...

# ── ZK Prover ────────────────────────────────────────────────────────────────
IMAGE_ID=0x...
SHIELDPASS_HOST_CLI=/path/to/shieldpass-prove
RISC0_DEV_MODE=1

# ── Email OTP ─────────────────────────────────────────────────────────────────
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# DEMO_OTP=123456  # uncomment to accept any code in demos

# ── x402 payment gate ───────────────────────────────────────────────────────
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_PAY_TO=0x0000000000000000000000000000000000000000
