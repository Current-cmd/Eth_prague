# ShieldPass backend — environment variables
# Copy this file to .env and fill in real values.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ── Space KMS (Orbitport) ────────────────────────────────────────────────────
# Required for POST /v1/badges/register (badge credential KMS storage).
# Obtain credentials from https://docs.spacecomputer.io
# The server starts without these but POST /v1/badges/register will return 502.
ORBITPORT_CLIENT_ID=your-orbitport-client-id-here
ORBITPORT_CLIENT_SECRET=your-orbitport-client-secret-here

# ── Pinata (IPFS) ────────────────────────────────────────────────────────────
# Used by POST /v1/ipfs/pin and POST /v1/ipfs/pin-json (evidence storage).
# These are unrelated to KMS — do not conflate.
PINATA_JWT=your-pinata-jwt-here

# ── x402 payment gate ───────────────────────────────────────────────────────
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_PAY_TO=0x0000000000000000000000000000000000000000
