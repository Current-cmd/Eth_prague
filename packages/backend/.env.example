# ─── Chain / RPC ────────────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── Deployed Contract Addresses (populated after forge script) ─
COMPANY_REGISTRY=
BADGE_TREE_MANAGER=
REPORT_REGISTRY=
SHIELDPASS_RESOLVER=
RISC0_VERIFIER=

# ─── KMS Mode Selection ────────────────────────────────────────
# If ORBITPORT_CLIENT_ID and ORBITPORT_CLIENT_SECRET are set,
# the backend will use SpaceComputer's orbital TEE for root signing.
# Otherwise, it falls back to a local mock wallet.

# Option A: SpaceComputer (real TEE)
# Get credentials from https://docs.spacecomputer.io/docs/how-to/authentication
ORBITPORT_CLIENT_ID=
ORBITPORT_CLIENT_SECRET=
# Set these after first key creation (logged to console on first run)
SPACECOMPUTER_KEY_ID=
SPACECOMPUTER_ETH_ADDRESS=
# A relayer key authorized to submit the TEE-signed txs
KMS_RELAYER_PRIVATE_KEY=

# Option B: Mock (local wallet, default for dev)
# Defaults to Anvil account #0 if not set
KMS_MOCK_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ─── Server ────────────────────────────────────────────────────
PORT=8787
CORS_ORIGIN=*
LOG_LEVEL=info
